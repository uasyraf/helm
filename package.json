{
  "name": "@uasyraf/helm",
  "version": "0.1.0",
  "description": "Plug-and-play MCP server + dashboard for durable, multi-developer project state. Sprints, epics, stories, tasks, code-linked tech debt.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "helm": "./dist/bin/helm.js"
  },
  "main": "./dist/server/src/index.js",
  "files": [
    "dist",
    "skills",
    "hooks",
    ".claude-plugin",
    ".mcp.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx server/src/index.ts",
    "dev": "tsx watch server/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "drizzle-orm": "^0.36.0",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
