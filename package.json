{
  "name": "@uasyraf/helm",
  "version": "0.1.3",
  "description": "Plug-and-play MCP server + dashboard for durable, multi-developer project state. Sprints, epics, stories, tasks, code-linked tech debt.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uasyraf/helm.git"
  },
  "bugs": {
    "url": "https://github.com/uasyraf/helm/issues"
  },
  "homepage": "https://github.com/uasyraf/helm#readme",
  "keywords": [
    "mcp",
    "claude-code",
    "project-management",
    "sprint",
    "tech-debt",
    "kanban",
    "scrum",
    "scrumban",
    "dashboard",
    "sveltekit",
    "turso",
    "libsql"
  ],
  "author": "Ummar Asyraf <ummar@artiselite.net>",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "helm": "dist/bin/helm.js"
  },
  "main": "./dist/server/src/index.js",
  "files": [
    "dist",
    "skills",
    "hooks",
    ".claude-plugin",
    ".mcp.json",
    "dashboard/build",
    "dashboard/package.json",
    "dashboard/svelte.config.js",
    "LICENSE",
    "README.md",
    "ONBOARDING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx server/src/index.ts",
    "dev": "tsx watch server/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@libsql/client": "^0.14.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.12.21",
    "jose": "^6.2.3",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
